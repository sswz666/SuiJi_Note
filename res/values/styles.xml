<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      关键：直接用系统自带的「对话框」主题，而不是自己拼一个透明全屏窗口。
      Theme.DeviceDefault.Light.Dialog 自带：
        windowIsFloating   = true            -> 浮动窗口，不会走「全屏 Activity」的启动缩放动画
        windowElevation    = 16dp            -> 真实阴影（不是画上去的）
        windowAnimationStyle = 弹窗淡入上浮   -> 打开时背景完全不收缩
        windowBackground   = 圆角卡片底
      这里把 windowBackground 换成透明，圆角卡片由我们自己的 View 画，尺寸也自己控制。
      注意：不要改回 windowIsTranslucent + 全屏，那样会重新触发启动缩放，并且高版本系统
      上还有启动页遮挡的问题。
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:backgroundDimAmount">0.0</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowAnimationStyle">@style/CardWindowAnimation</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:textColorHighlight">#334759B8</item>
    </style>

    <!--
      只保留卡片自己的淡入上浮（window 级动画），
      系统级的 activity / task / wallpaper 转场全部置空：
      冷启动时不再播「图标展开成窗口」的缩放，卡片直接就在原位。
      之前只定义了 window 级动画，activity/task 转场走系统默认，冷启动就是一次缩放。
    -->
    <style name="CardWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
        <item name="android:wallpaperOpenEnterAnimation">@null</item>
        <item name="android:wallpaperOpenExitAnimation">@null</item>
        <item name="android:wallpaperCloseEnterAnimation">@null</item>
        <item name="android:wallpaperCloseExitAnimation">@null</item>
        <item name="android:wallpaperIntraOpenEnterAnimation">@null</item>
        <item name="android:wallpaperIntraOpenExitAnimation">@null</item>
        <item name="android:wallpaperIntraCloseEnterAnimation">@null</item>
        <item name="android:wallpaperIntraCloseExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@anim/card_in</item>
        <item name="android:windowExitAnimation">@anim/card_out</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CardIndex">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/faint</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CardBody">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.42</item>
        <item name="android:includeFontPadding">false</item>
        <!-- 默认不允许选中：空白卡没有可复制内容，由代码在有正文时开启 -->
        <item name="android:textIsSelectable">false</item>
    </style>

    <style name="CardFoot">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/hint</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 故障兜底页：不透明，保证任何情况下都能看到内容 -->
    <style name="ErrorTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:colorBackground">#FFFFFFFF</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
